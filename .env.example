# Salin file ini menjadi .env.local lalu isi nilainya.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alamat web (lokal: http://localhost:3000; produksi: https://nama-proyek.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hanya untuk skrip & tes di komputer ini. JANGAN diisi di Vercel.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase → Connect → Session pooler (URI), ganti [YOUR-PASSWORD]
SUPABASE_DB_URL=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
